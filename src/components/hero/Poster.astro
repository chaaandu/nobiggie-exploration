---
/**
 * The hero's first frame: a still of the 3D scene (npm run render), so the switch to live 3D
 * is invisible. It's also the 2D version's sealed state.
 */
import { flavourById, dips, type FlavourId } from '../../content/facts';
import { renders } from '../../content/renders';

interface Props {
  flavour: FlavourId;
}
const f = flavourById(Astro.props.flavour);
const r = renders.poster[f.id];
const alt = `A clear cup of ${f.name} mini cookies with a dome lid of ${dips[f.dip].name.toLowerCase()} dip, on a cream table`;
const sizes = '(min-width: 900px) 600px, (min-width: 640px) 76vw, 100vw';
---

<div class="poster" data-poster>
  {
    r && (
      <picture>
        <source type="image/avif" srcset={r.avif} sizes={sizes} />
        <img src={r.fallback} srcset={r.webp} sizes={sizes} width={r.width} height={r.height} alt={alt} fetchpriority="high" decoding="async" />
      </picture>
    )
  }
</div>

<style>
  .poster {
    position: absolute;
    inset: 0;
  }
  .poster img {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
