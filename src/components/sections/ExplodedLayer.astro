---
/** One layer of the exploded cup, rendered from the 3D scene with the same camera as the others. */
import { existsSync } from 'node:fs';

interface Props {
  part: 'lid' | 'cookies' | 'cup';
}
const { part } = Astro.props;
const src = `/renders/exploded-${part}-800.webp`;
const has = existsSync(`public${src}`);
---

{has && <img class={`xl xl-${part}`} src={src} alt="" loading="lazy" decoding="async" width="800" height="800" />}
