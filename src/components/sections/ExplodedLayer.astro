---
/** One layer of the exploded cup. Uses the 3D renders when they exist, simple shapes until then. */
import { existsSync } from 'node:fs';
import { defaultFlavour, dips, flavourById } from '../../content/facts';

interface Props {
  part: 'lid' | 'dip' | 'cookies' | 'cup';
}
const { part } = Astro.props;
const f = flavourById(defaultFlavour);
const src = `/renders/exploded-${part}.webp`;
const hasRender = existsSync(`public${src}`);
---

{
  hasRender ? (
    <img class={`xl xl-${part}`} src={src} alt="" loading="lazy" decoding="async" width="800" height="600" />
  ) : (
    <div class={`xl xl-${part} xl-ph`} style={`--c:${f.look.cookie};--d:${dips[f.dip].colour}`} aria-hidden="true" />
  )
}

<style>
  .xl-ph {
    aspect-ratio: 4 / 3;
  }
  .xl-lid.xl-ph {
    aspect-ratio: 2 / 1;
    border-radius: 999px 999px 8px 8px;
    border: 3px solid rgb(255 255 255 / 0.9);
    background: rgb(255 255 255 / 0.25);
    box-shadow: inset 0 0 0 2px rgb(59 36 22 / 0.12);
  }
  .xl-dip.xl-ph {
    aspect-ratio: 2.4 / 1;
    width: 54% !important;
    border-radius: 999px 999px 40% 40%;
    background: var(--d);
  }
  .xl-cookies.xl-ph {
    aspect-ratio: 2 / 1.1;
    width: 56% !important;
    background: radial-gradient(circle at 20% 40%, var(--c) 0 18%, transparent 19%), radial-gradient(circle at 50% 30%, var(--c) 0 18%, transparent 19%),
      radial-gradient(circle at 80% 45%, var(--c) 0 18%, transparent 19%), radial-gradient(circle at 35% 75%, var(--c) 0 18%, transparent 19%),
      radial-gradient(circle at 66% 75%, var(--c) 0 18%, transparent 19%);
  }
  .xl-cup.xl-ph {
    aspect-ratio: 1 / 1.05;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 16% 100%);
    background: rgb(255 255 255 / 0.35);
    box-shadow: inset 0 0 0 3px rgb(59 36 22 / 0.15);
  }
</style>
