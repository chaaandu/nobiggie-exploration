---
/** Four confirmed facts (CLAUDE.md), set like a label on the side of the cup. */
const items = [
  { t: 'Dip sealed in every lid', d: '<path d="M5 16h22"/><path d="M7 16a9 9 0 0 1 18 0"/><path d="M10 16c0 2.5 1.5 3 2.5 3s1.5-1.4 1.5-3M18 16v3.5"/>' },
  { t: 'New York style, baked mini', d: '<circle cx="16" cy="16" r="9.5"/><circle cx="13" cy="13.5" r="1.3"/><circle cx="19" cy="15" r="1.1"/><circle cx="15" cy="20" r="1.4"/>' },
  { t: 'Real chocolate, no compound', d: '<rect x="8" y="7" width="16" height="19" rx="2"/><path d="M8 13.3h16M8 19.6h16M16 7v19"/>' },
  { t: 'Made to order, same day', d: '<circle cx="16" cy="17" r="9"/><path d="M16 12v5l3.5 2.2"/><path d="M13 5.5h6"/>' },
];
---

<section class="strip" aria-label="What's in every cup">
  <ul role="list" class="wrap strip-row">
    {
      items.map((i) => (
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true" set:html={i.d} />
          <span>{i.t}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .strip {
    border-block: 1.5px dashed var(--line-strong);
    background: rgb(239 228 209 / 0.45);
  }
  .strip-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 18px;
    padding-block: 18px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 0.93rem;
    line-height: 1.25;
  }
  svg {
    width: 30px;
    height: 30px;
    flex: none;
    fill: none;
    stroke: var(--velvet);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 900px) {
    .strip-row {
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
      padding-block: 22px;
    }
    li {
      font-size: 1rem;
    }
  }
</style>
