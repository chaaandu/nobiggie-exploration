---
interface Props {
  kicker: string;
  title: string;
  /** Optional italic second line, like the hero. */
  em?: string;
  lede?: string;
}
const { kicker, title, em, lede } = Astro.props;
---

<header class="wrap page-head stack stack-4">
  <p class="kicker">{kicker}</p>
  <h1>{title}{em && <> <em>{em}</em></>}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-top: clamp(28px, 6vw, 72px);
    padding-bottom: clamp(24px, 4vw, 48px);
    max-width: calc(var(--wrap) - 0px);
  }
  h1 {
    font-size: clamp(2.6rem, 1.6rem + 4.6vw, 5.4rem);
    max-width: 16ch;
  }
  h1 em {
    display: block;
    color: var(--velvet);
  }
  .lede {
    max-width: 52ch;
  }
</style>
