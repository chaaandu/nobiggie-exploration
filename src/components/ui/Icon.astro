---
/** Inline stroke icons, drawn slightly loose to sit next to the handwriting. */
export type IconName =
  | 'bag' | 'menu' | 'close' | 'plus' | 'minus' | 'sound' | 'mute' | 'motion' | 'still' | 'eye'
  | 'refill' | 'record' | 'whatsapp' | 'phone' | 'instagram' | 'arrow' | 'arrow-down' | 'check'
  | 'download' | 'share' | 'mail' | 'pin' | 'clock' | 'lid';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 22, class: cls, label } = Astro.props;

const paths: Record<IconName, string> = {
  bag: '<path d="M5.5 8.5h13l-1 11.2a1.5 1.5 0 0 1-1.5 1.3H8a1.5 1.5 0 0 1-1.5-1.3z"/><path d="M9 10.5V7a3 3 0 0 1 6 0v3.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h11"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  sound: '<path d="M4 10v4h3.5L12 18V6L7.5 10z"/><path d="M15.5 9.2a4 4 0 0 1 0 5.6M18 6.8a7.4 7.4 0 0 1 0 10.4"/>',
  mute: '<path d="M4 10v4h3.5L12 18V6L7.5 10z"/><path d="m16 9.5 5 5M21 9.5l-5 5"/>',
  motion: '<path d="M3 12c2.5-4 5.5-4 8 0s5.5 4 8 0"/><path d="M19 8.5v3.5h-3.5"/>',
  still: '<path d="M4 12h16"/><circle cx="12" cy="12" r="2.2"/>',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>',
  refill: '<path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3"/><path d="M19.6 4.2v3.6h-3.6"/>',
  record: '<circle cx="12" cy="12" r="8.2"/><circle cx="12" cy="12" r="3.6" fill="currentColor" stroke="none"/>',
  whatsapp: '<path d="M4.3 19.7 5.4 16A8 8 0 1 1 8.3 18.9z"/><path d="M9.2 8.6c.2-.6.6-.7 1-.7l.6.1 1 2.2-.6 1c.5 1 1.3 1.8 2.4 2.4l1-.6 2.2 1v.6c0 .5-.3.9-.8 1.1-1.4.5-3.2-.1-5-1.9-1.8-1.8-2.4-3.6-1.8-5.2z" fill="currentColor" stroke="none"/>',
  phone: '<path d="M6.5 3.8h3l1.4 4.2-2.1 1.4a10.6 10.6 0 0 0 5.8 5.8l1.4-2.1 4.2 1.4v3a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.5 6a2 2 0 0 1 2-2.2z"/>',
  instagram: '<rect x="3.8" y="3.8" width="16.4" height="16.4" rx="4.6"/><circle cx="12" cy="12" r="3.9"/><circle cx="17.3" cy="6.7" r=".9" fill="currentColor" stroke="none"/>',
  arrow: '<path d="M4 12.3c4.6-.4 9.5-.5 15-.3"/><path d="m14.5 7.2 4.8 4.8-4.8 4.9"/>',
  'arrow-down': '<path d="M12 4.5c.3 4.6.3 9.4 0 14.5"/><path d="m7.3 14.6 4.7 4.8 4.8-4.8"/>',
  check: '<path d="m4.8 12.6 4.6 4.4L19.4 7"/>',
  download: '<path d="M12 4v11"/><path d="m7.5 10.8 4.5 4.6 4.5-4.6"/><path d="M5 19.5h14"/>',
  share: '<path d="M12 15V4"/><path d="m7.6 8.2 4.4-4.4 4.4 4.4"/><path d="M5.5 12.5v6a1.5 1.5 0 0 0 1.5 1.5h10a1.5 1.5 0 0 0 1.5-1.5v-6"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>',
  pin: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  lid: '<path d="M4 15.5h16"/><path d="M5.5 15.5a6.5 6.5 0 0 1 13 0"/><path d="M9 9.5c.3-1.9 1.4-3.2 3-3.6"/>',
};
---

<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name]}
/>
