---
import Base from '../layouts/Base.astro';
import { defaultFlavour } from '../content/facts';
import { quickOrderHref } from '../lib/checkout';
---

<Base title="This page has been eaten · No Biggie" description="Nothing here but crumbs." noindex>
  <section class="wrap gone">
    <p class="big" aria-hidden="true">
      <span>4</span>
      <svg class="cookie" viewBox="0 0 120 120">
        <path
          d="M60 6c29.8 0 54 24.2 54 54s-24.2 54-54 54S6 89.8 6 60c0-5 .7-9.8 1.9-14.4 5.6 3 12.8 2.1 17.5-2.6 4.6-4.6 5.6-11.5 2.9-17.1 5.7 1.6 12.1.2 16.6-4.3 4.6-4.6 6-11.2 4.2-17 4.2-1.6 8.3-2.6 12.9-2.6z"
          fill="#C08A54"></path>
        <circle cx="44" cy="52" r="7" fill="#2A170E"></circle>
        <circle cx="76" cy="44" r="5.5" fill="#2A170E"></circle>
        <circle cx="70" cy="80" r="8" fill="#2A170E"></circle>
        <circle cx="40" cy="84" r="4.5" fill="#2A170E"></circle>
        <circle cx="94" cy="68" r="4" fill="#2A170E"></circle>
      </svg>
      <span>4</span>
    </p>
    <h1>This page has been eaten.</h1>
    <p class="lede">Nothing here but crumbs. The rest of the site is fine. Probably.</p>
    <div class="row gone-actions">
      <a class="btn" href="/">Back to the cup</a>
      <a class="btn btn-ghost" href={quickOrderHref(defaultFlavour)} data-order>Order a replacement</a>
    </div>
    <ul class="crumbs" aria-hidden="true">
      {Array.from({ length: 11 }, (_, i) => <li style={`--x:${(i * 37) % 100}%;--y:${4 + ((i * 29) % 13)}%;--r:${(i * 53) % 360}deg;--s:${0.5 + ((i * 7) % 5) / 6}`} />)}
    </ul>
  </section>
</Base>

<style>
  .gone {
    position: relative;
    min-height: 70svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--s-5);
    padding-block: var(--s-8);
  }
  .big {
    display: flex;
    align-items: center;
    gap: 0.06em;
    font-family: var(--f-display);
    font-weight: 760;
    font-size: clamp(6rem, 4rem + 14vw, 14rem);
    line-height: 1;
  }
  .cookie {
    width: 0.8em;
    height: 0.8em;
    transform: rotate(-12deg);
    filter: drop-shadow(0 8px 10px rgb(59 36 22 / 0.25));
  }
  h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem);
  }
  .gone-actions {
    justify-content: center;
  }
  .crumbs li {
    position: absolute;
    bottom: var(--y);
    left: var(--x);
    width: 10px;
    height: 8px;
    background: #B98250;
    border-radius: 40% 60% 50% 45%;
    transform: rotate(var(--r)) scale(var(--s));
    list-style: none;
  }
</style>
